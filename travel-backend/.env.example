# Copy to .env (never commit .env). In production inject these via your platform's secret manager.
ENV=production                        # default if unset. Use ENV=development only on your laptop (production hides /docs and needs every setting below)
CORS_ORIGINS=https://yourdomain.com   # comma-separated; no wildcard

# Supabase: use the SERVICE ROLE key (server-side only; bypasses RLS). Never ship it to the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=itineraries            # private bucket (generated PDFs)
BLUEPRINT_BUCKET=blueprints           # private bucket (ready-made blueprint PDFs)

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash         # check current model names in Google AI Studio
GEMINI_TIMEOUT_S=90
MAX_DAILY_GENERATIONS=100             # hard cost cap on Gemini calls per UTC day

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=              # set the same value in Razorpay Dashboard > Webhooks
RAZORPAY_CALLBACK_URL=                # optional thank-you page on your site

# Admin: min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=

# Alerts (REQUIRED when ENV=production: paid-but-failed and underpayment alerts must never be dropped silently)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (optional; all four or none). Meta for Developers > your app > WhatsApp. See README "WhatsApp".
WHATSAPP_ACCESS_TOKEN=                # a permanent System User token, not the 24-hour test token
WHATSAPP_PHONE_NUMBER_ID=             # the Phone number ID (not the phone number)
WHATSAPP_VERIFY_TOKEN=                # any long random string you also type into Meta's webhook setup
WHATSAPP_APP_SECRET=                  # App settings > Basic > App secret: used to verify every webhook signature
WHATSAPP_GRAPH_VERSION=v23.0          # check Meta's Graph API changelog; old versions are retired

# Business rules
WHATSAPP_NUMBER=91XXXXXXXXXX          # digits only, country code first
BRAND_NAME=GhumoCo
CUSTOM_PLAN_PRICE_INR=2499
ADVANCE_PCT=50
GST_RATE_PCT=5                        # CONFIRM with your CA; used as the default in pricing_engine

# Deployment (read by uvicorn, not by the app). Set to your proxy / load balancer address or CIDR.
# Never '*': any client could then spoof X-Forwarded-For and bypass every per-IP rate limit (the app refuses to start).
# Unset behind a load balancer = all visitors share one rate-limit bucket.
FORWARDED_ALLOW_IPS=

# Bot protection for the lead forms (recommended before running ads). Create a Turnstile widget in the Cloudflare dashboard:
# put the SITE KEY in the website's brand.json (turnstile_site_key) and the SECRET here. Empty = no check.
TURNSTILE_SECRET=
